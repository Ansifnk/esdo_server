// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  roles     UserRole[]
  saloonId  String?
  saloon    Saloon?    @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  reviews   Review[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
}

model Customer {
  id        String    @id @default(uuid())
  phone     String?   @unique
  email     String?   @unique
  password  String?
  name      String?
  points    Int       @default(0)
  cart      Cart?
  bookings  Booking[]
  payments  Payment[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Saloon {
  id          String            @id @default(uuid())
  name        String
  location    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       User[]
  staffs      Staff[]
  services    Service[]
  packages    Package[]
  offers      Offer[]
  attendances StaffAttendance[]
  bookings    Booking[]
  reviews     Review[]
}

enum Role {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
}

model Category {
  id            String        @id @default(uuid())
  name          String
  image         String        @default("")
  gender        ServiceGender @default(UNI)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  staffs        Staff[]
  services      Service[]
}

model SubCategory {
  id         String    @id @default(uuid())
  name       String
  image      String    @default("")
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  staffs     Staff[]
  services   Service[]
}

model File {
  id           String    @id @default(uuid())
  originalName String
  path         String
  bucket       String
  isPrivate    Boolean   @default(false)
  publicUrl    String    @default("")
  mimeType     String
  fileSize     BigInt
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

enum StaffType {
  STYLIST
  MANAGER
  RECEPTIONIST
}

enum StylistCategory {
  PRIME
  GOLD
  SILVER
}

model Staff {
  id              String            @id @default(uuid())
  name            String
  phone           String            @default("")
  languages       String[]          @default([])
  image           String            @default("")
  isActive        Boolean           @default(true)
  type            StaffType         @default(STYLIST)
  serviceGender   ServiceGender?
  stylistCategory StylistCategory?
  joiningDate     String            @default("")
  saloonId        String
  saloon          Saloon            @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories      Category[]
  subCategories   SubCategory[]
  slots           StaffSlot[]
  services        Service[]
  attendances     StaffAttendance[]
  cartItems       CartItem[]
  bookingItems    BookingItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model StaffSlot {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      String
  slots     String[] @default([])
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId, date])
}

enum ServiceGender {
  MALE
  FEMALE
  UNI
}

model Service {
  id               String        @id @default(uuid())
  name             String
  shortDescription String        @default("")
  nickName         String        @default("")
  description      String
  price            Float
  discountPrice    Float
  serviceGender    ServiceGender @default(UNI)
  primaryImage     String        @default("")
  images           String[]      @default([])
  afterCareMessage String        @default("")
  duration         Int           @default(0)
  saloonId         String
  saloon           Saloon        @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories       Category[]
  subCategories    SubCategory[]
  stylists         Staff[]
  relatedServices  Service[]     @relation("ServiceToService")
  relatedTo        Service[]     @relation("ServiceToService")
  packages         Package[]
  offers           Offer[]
  cartItems        CartItem[]
  bookingItems     BookingItem[]
  reviews          Review[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Package {
  id            String    @id @default(uuid())
  name          String
  nickName      String    @default("")
  description   String
  price         Float
  discountPrice Float     @default(0)
  primaryImage  String    @default("")
  images        String[]  @default([])
  saloonId      String
  saloon        Saloon    @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  offers        Offer[]
  cartItems     CartItem[]
  bookingItems  BookingItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum OfferType {
  BANNER
  COUPON
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Offer {
  id            String        @id @default(uuid())
  name          String
  description   String        @default("")
  type          OfferType
  gender        ServiceGender @default(UNI)
  bannerImage   String        @default("")
  couponCode    String        @default("")
  discountType  DiscountType  @default(PERCENTAGE)
  discountValue Float         @default(0)
  isActive      Boolean       @default(true)
  startDate     DateTime?
  endDate       DateTime?
  saloonId      String?
  saloon        Saloon?       @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  packages      Package[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
}

model StaffAttendance {
  id        String           @id @default(uuid())
  staffId   String
  saloonId  String
  date      String
  checkIn   String?          @default("")
  checkOut  String?          @default("")
  status    AttendanceStatus @default(PRESENT)
  notes     String?          @default("")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  saloon Saloon @relation(fields: [saloonId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([saloonId, date])
}

model Otp {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp        String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponCode String?    @default("")
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date      String?  @default("")
  timeSlot  String?  @default("")
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saloonId      String?
  saloon        Saloon?       @relation(fields: [saloonId], references: [id], onDelete: SetNull)
  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(SUCCESS)
  subtotal      Float
  discount      Float         @default(0)
  totalAmount   Float
  pointsUsed    Int           @default(0)
  pointsEarned  Int           @default(0)
  couponCode    String?       @default("")
  paymentId     String?       @unique
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  items         BookingItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date      String?  @default("")
  timeSlot  String?  @default("")
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String        @id @default(uuid())
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking           Booking?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id         String    @id @default(uuid())
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  saloonId   String?
  saloon     Saloon?   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float     @default(5)
  comment    String
  userName   String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([serviceId])
  @@index([saloonId])
  @@index([customerId])
}
