// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  roles     UserRole[]
  saloonId  String?
  saloon    Saloon?    @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
}

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Saloon {
  id        String    @id @default(uuid())
  name      String
  location  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  staffs    Staff[]
  services  Service[]
  packages  Package[]
  offers    Offer[]
}

enum Role {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
}

model Category {
  id            String        @id @default(uuid())
  name          String
  image         String        @default("")
  gender        ServiceGender @default(UNI)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  staffs        Staff[]
  services      Service[]
}

model SubCategory {
  id         String    @id @default(uuid())
  name       String
  image      String    @default("")
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  staffs     Staff[]
  services   Service[]
}

model File {
  id           String    @id @default(uuid())
  originalName String
  path         String
  bucket       String
  isPrivate    Boolean   @default(false)
  publicUrl    String    @default("")
  mimeType     String
  fileSize     BigInt
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

enum StaffType {
  STYLIST
  MANAGER
  RECEPTIONIST
}

model Staff {
  id             String                  @id @default(uuid())
  name           String
  phone          String                  @default("")
  languages      String[]                @default([])
  image          String                  @default("")
  isActive       Boolean                 @default(true)
  type           StaffType               @default(STYLIST)
  serviceGender  ServiceGender           @default(UNI)
  saloonId       String
  saloon         Saloon                  @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories     Category[]
  subCategories  SubCategory[]
  availabilities StaffAvailability[]
  overrides      StaffScheduleOverride[]
  services       Service[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model StaffAvailability {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate String   @default("")
  endDate   String   @default("")
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ScheduleOverrideType {
  LEAVE
  CUSTOM_HOURS
}

model StaffScheduleOverride {
  id        String               @id @default(uuid())
  staffId   String
  staff     Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      String
  type      ScheduleOverrideType @default(LEAVE)
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

enum ServiceGender {
  MALE
  FEMALE
  UNI
}

model Service {
  id               String        @id @default(uuid())
  name             String
  shortDescription String        @default("")
  nickName         String        @default("")
  description      String
  price            Float
  discountPrice    Float
  serviceGender    ServiceGender @default(UNI)
  primaryImage     String        @default("")
  images           String[]      @default([])
  afterCareMessage String        @default("")
  duration         Int           @default(0)
  saloonId         String
  saloon           Saloon        @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories       Category[]
  subCategories    SubCategory[]
  stylists         Staff[]
  relatedServices  Service[]     @relation("ServiceToService")
  relatedTo        Service[]     @relation("ServiceToService")
  packages         Package[]
  offers           Offer[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Package {
  id            String    @id @default(uuid())
  name          String
  description   String
  price         Float
  discountPrice Float     @default(0)
  primaryImage  String    @default("")
  images        String[]  @default([])
  saloonId      String
  saloon        Saloon    @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  offers        Offer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum OfferType {
  BANNER
  COUPON
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Offer {
  id            String       @id @default(uuid())
  name          String
  description   String       @default("")
  type          OfferType
  bannerImage   String       @default("")
  couponCode    String       @default("")
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float        @default(0)
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  saloonId      String?
  saloon        Saloon?      @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  packages      Package[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
