// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  roles     UserRole[]
  saloonId  String?
  saloon    Saloon?    @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  reviews   Review[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
}

model Customer {
  id          String       @id @default(uuid())
  phone       String?      @unique
  email       String?      @unique
  password    String?
  name        String?
  points      Int          @default(0)
  cart        Cart?
  bookings    Booking[]
  payments    Payment[]
  reviews     Review[]
  invoices    Invoice[]
  memberships        Membership[]
  referralCode       String?             @unique
  referredById       String?
  referredBy         Customer?           @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referralsMade      Customer[]          @relation("CustomerReferrals")
  referralRecords    Referral[]          @relation("ReferrerRel")
  referralReceived   Referral?           @relation("ReferredCustomerRel")
  rewardTransactions RewardTransaction[]
  packages           Package[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Saloon {
  id          String            @id @default(uuid())
  name        String
  location    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       User[]
  staffs      Staff[]
  services    Service[]
  packages    Package[]
  offers      Offer[]
  attendances StaffAttendance[]
  bookings    Booking[]
  reviews     Review[]
  invoices    Invoice[]
}

enum Role {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
}

model Category {
  id            String        @id @default(uuid())
  name          String
  image         String        @default("")
  gender        ServiceGender @default(UNI)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  staffs        Staff[]
  services      Service[]
}

model SubCategory {
  id         String    @id @default(uuid())
  name       String
  image      String    @default("")
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  staffs     Staff[]
  services   Service[]
}

model File {
  id           String    @id @default(uuid())
  originalName String
  path         String
  bucket       String
  isPrivate    Boolean   @default(false)
  publicUrl    String    @default("")
  mimeType     String
  fileSize     BigInt
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

enum StaffType {
  STYLIST
  MANAGER
  RECEPTIONIST
}

enum StylistCategory {
  PRIME
  GOLD
  SILVER
}

model Staff {
  id              String            @id @default(uuid())
  name            String
  phone           String            @default("")
  languages       String[]          @default([])
  image           String            @default("")
  isActive        Boolean           @default(true)
  type            StaffType         @default(STYLIST)
  serviceGender   ServiceGender?
  stylistCategory StylistCategory?
  joiningDate     String            @default("")
  saloonId        String
  saloon          Saloon            @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories      Category[]
  subCategories   SubCategory[]
  slots           StaffSlot[]
  services        Service[]
  attendances     StaffAttendance[]
  cartItems       CartItem[]
  bookingItems    BookingItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model StaffSlot {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      String
  slots     String[] @default([])
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId, date])
}

enum ServiceGender {
  MALE
  FEMALE
  UNI
}

model Service {
  id               String        @id @default(uuid())
  name             String
  shortDescription String        @default("")
  nickName         String        @default("")
  description      String
  price            Float
  discountPrice    Float
  serviceGender    ServiceGender @default(UNI)
  primaryImage     String        @default("")
  images           String[]      @default([])
  afterCareMessage String        @default("")
  duration         Int           @default(0)
  saloonId         String
  saloon           Saloon        @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  categories       Category[]
  subCategories    SubCategory[]
  stylists         Staff[]
  relatedServices  Service[]     @relation("ServiceToService")
  relatedTo        Service[]     @relation("ServiceToService")
  packages         Package[]
  offers           Offer[]
  cartItems        CartItem[]
  bookingItems     BookingItem[]
  reviews          Review[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Package {
  id            String        @id @default(uuid())
  name          String
  nickName      String        @default("")
  description   String
  price         Float
  discountPrice Float         @default(0)
  primaryImage  String        @default("")
  images        String[]      @default([])
  saloonId      String
  saloon        Saloon        @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  offers        Offer[]
  cartItems     CartItem[]
  bookingItems  BookingItem[]
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  isCustom      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
}

model PackageSetting {
  id                 String   @id @default(uuid())
  discountPercentage Float    @default(15.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum OfferType {
  BANNER
  COUPON
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Offer {
  id            String        @id @default(uuid())
  name          String
  description   String        @default("")
  type          OfferType
  gender        ServiceGender @default(UNI)
  bannerImage   String        @default("")
  couponCode    String        @default("")
  discountType  DiscountType  @default(PERCENTAGE)
  discountValue Float         @default(0)
  isActive      Boolean       @default(true)
  startDate     DateTime?
  endDate       DateTime?
  saloonId      String?
  saloon        Saloon?       @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  services      Service[]
  packages      Package[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
}

model StaffAttendance {
  id        String           @id @default(uuid())
  staffId   String
  saloonId  String
  date      String
  checkIn   String?          @default("")
  checkOut  String?          @default("")
  status    AttendanceStatus @default(PRESENT)
  notes     String?          @default("")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  saloon Saloon @relation(fields: [saloonId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([saloonId, date])
}

model Otp {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp        String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponCode String?    @default("")
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date      String?  @default("")
  timeSlot  String?  @default("")
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Booking {
  id                     String                  @id @default(uuid())
  bookingNumber          String                  @unique
  customerId             String
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saloonId               String?
  saloon                 Saloon?                 @relation(fields: [saloonId], references: [id], onDelete: SetNull)
  status                 BookingStatus           @default(CONFIRMED)
  paymentStatus          PaymentStatus           @default(SUCCESS)
  subtotal               Float
  discount               Float                   @default(0)
  totalAmount            Float
  pointsUsed             Int                     @default(0)
  pointsEarned           Int                     @default(0)
  membershipUsed         Float                   @default(0)
  couponCode             String?                 @default("")
  paymentId              String?                 @unique
  payment                Payment?                @relation(fields: [paymentId], references: [id])
  items                  BookingItem[]
  membershipTransactions MembershipTransaction[]
  invoice                Invoice?
  rewardTransactions     RewardTransaction[]
  referralsQualified     Referral[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date      String?  @default("")
  timeSlot  String?  @default("")
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String        @id @default(uuid())
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking           Booking?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id         String    @id @default(uuid())
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  saloonId   String?
  saloon     Saloon?   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float     @default(5)
  comment    String
  userName   String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([serviceId])
  @@index([saloonId])
  @@index([customerId])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saloonId      String?
  saloon        Saloon?  @relation(fields: [saloonId], references: [id], onDelete: SetNull)
  subtotal      Float
  discount      Float    @default(0)
  totalAmount   Float
  items         Json     @default("[]")
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([saloonId])
}

model Membership {
  id           String                  @id @default(uuid())
  customerId   String
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount       Float // Amount paid by user (e.g. 10000)
  initialValue Float // Benefit value granted (e.g. 13000)
  balance      Float // Current available benefit value
  startDate    DateTime                @default(now())
  endDate      DateTime? // Optional expiry date (null = infinite)
  isActive     Boolean                 @default(true)
  note         String?                 @default("")
  transactions MembershipTransaction[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([customerId])
  @@index([isActive])
}

enum MembershipTxType {
  CREDIT
  DEBIT
}

model MembershipTransaction {
  id            String           @id @default(uuid())
  membershipId  String
  membership    Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type          MembershipTxType
  amount        Float //amount paid
  balanceBefore Float
  balanceAfter  Float
  bookingId     String?
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  note          String?          @default("")
  createdAt     DateTime         @default(now())

  @@index([membershipId])
  @@index([bookingId])
}

model RewardSetting {
  id                             String   @id @default(uuid())
  isSpendRewardEnabled           Boolean  @default(true)
  spendAmountPerUnit             Float    @default(100.0) // Every ₹100
  coinsEarnedPerUnit             Int      @default(1)     // Earns 1 coin
  coinRedemptionValue            Float    @default(1.0)   // ₹1 value per coin
  minRedemptionCoins             Int      @default(100)   // Min 100 coins
  maxRedemptionPercentage        Float    @default(20.0)  // Max 20% of order value
  allowCombineWithCoupon         Boolean  @default(true)  // Can combine with coupons
  spendCoinExpiryMonths          Int      @default(12)    // Expiry duration in months

  isReferralEnabled              Boolean  @default(true)
  referredUserDiscountAmount     Float    @default(125.0) // ₹125 OFF on first booking
  referredUserMinOrderAmount     Float    @default(500.0) // Min order amount for welcome discount
  referredUserDiscountExpiryDays Int      @default(30)    // Validity of welcome coupon
  referralCoinExpiryMonths       Int      @default(12)    // Expiry duration for referral coins
  defaultReferralCoins           Int      @default(200)   // Fallback for counts beyond defined slabs
  shareMessageTemplate           String   @default("Sharing something I personally love ❤️ Es_Do has been amazing for salon & wellness services. Use my referral code {code} to get ₹{discount} OFF on your first booking. Visit now: {url}")

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model ReferralRewardSlab {
  id                 String   @id @default(uuid())
  referralCount      Int      @unique // 1, 2, 3, 4, 5, 10, 15
  coinsEarned        Int      // 200, 350, 425, 525, etc.
  hasMilestoneReward Boolean  @default(false)
  milestoneTitle     String?  // "Free service unlocked"
  milestoneType      String?  // "FREE_SERVICE_VOUCHER"
  milestoneValue     Float?   // Optional max cap for free service
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  CANCELLED
}

model Referral {
  id                  String         @id @default(uuid())
  referrerId          String
  referrer            Customer       @relation("ReferrerRel", fields: [referrerId], references: [id], onDelete: Cascade)
  referredCustomerId  String         @unique
  referredCustomer    Customer       @relation("ReferredCustomerRel", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  referralCodeUsed    String
  referralNumber      Int            // 1st, 2nd, 3rd, etc. for this referrer
  status              ReferralStatus @default(PENDING)
  coinsAwarded        Int            @default(0)
  milestoneUnlocked   Boolean        @default(false)
  milestoneTitle      String?
  qualifyingBookingId String?
  qualifyingBooking   Booking?       @relation(fields: [qualifyingBookingId], references: [id], onDelete: SetNull)
  transactions        RewardTransaction[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([referrerId])
  @@index([status])
}

enum RewardTxType {
  SPEND_EARN
  REFERRAL_EARN
  REDEMPTION
  REFUND_REVERSAL
  EXPIRY
  ADMIN_ADJUSTMENT
}

enum RewardTxStatus {
  ACTIVE
  EXPIRED
  REVERSED
  FULLY_CONSUMED
}

model RewardTransaction {
  id             String           @id @default(uuid())
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           RewardTxType
  amount         Int              // Positive for credit (+50), negative for debit (-100)
  balanceBefore  Int
  balanceAfter   Int
  remainingCoins Int              @default(0) // Remaining unspent coins in this credit batch
  expiresAt      DateTime?        // Batch expiration date
  status         RewardTxStatus   @default(ACTIVE)
  bookingId      String?
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  referralId     String?
  referral       Referral?        @relation(fields: [referralId], references: [id], onDelete: SetNull)
  notes          String?          @default("")
  createdAt      DateTime         @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@index([status])
}

